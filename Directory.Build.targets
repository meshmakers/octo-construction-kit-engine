<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <OctoCkcToolPath>$(MSBuildThisFileDirectory)bin/$(Configuration)/net10.0/publish/octo-ckc.dll</OctoCkcToolPath>
        <OctoCompilerToolPath>dotnet $(OctoCkcToolPath)</OctoCompilerToolPath>
        <IsOctoCompilerFound>false</IsOctoCompilerFound>
        <IsOctoCompilerFound>$([System.IO.File]::Exists($(OctoCkcToolPath)))</IsOctoCompilerFound>
        <OctoCkCompileOutputImportFolder Condition="'$(OctoCkCompileOutputImportFolder)' == ''">$(OutputPath)octo-ck-libraries/$(ProjectName)/imports</OctoCkCompileOutputImportFolder>
        <OctoCkCompileCacheImportFolder Condition="'$(OctoCkCompileCacheImportFolder)' == ''">$(IntermediateOutputPath)octo-ck-cache/$(ProjectName)/imports</OctoCkCompileCacheImportFolder>
        <OctoCkCompileOutputCompilerFolder Condition="'$(OctoCkCompileOutputCompilerFolder)' == ''">$(OutputPath)octo-ck-libraries/$(ProjectName)/out</OctoCkCompileOutputCompilerFolder>
        <OctoCkCompileCacheCompileFolder Condition="'$(OctoCkCompileCacheCompileFolder)' == ''">$(IntermediateOutputPath)octo-ck-cache/$(ProjectName)/out</OctoCkCompileCacheCompileFolder>
        <!-- One shared -lcr fragment for every octo-ckc invocation that touches the local catalog
             (compile, publish, restore). A single definition keeps all of them on the SAME catalog
             root — one Exec missing it would publish to one directory and resolve from another. -->
        <_OctoLcrArg Condition="'$(OctoLocalCatalogRootPath)' != ''">-lcr &quot;$(OctoLocalCatalogRootPath)&quot;</_OctoLcrArg>
        <!-- CK v2 range retention spike (AB#5664), default off: -rr is only passed when the property is set. -->
        <_OctoRrArg Condition="'$(OctoCkRangeRetention)' != ''">-rr $(OctoCkRangeRetention)</_OctoRrArg>
    </PropertyGroup>
    
    <!--Defining all the text files input parameters-->
    <ItemGroup>
        <ConstructionKitConfigFile Include="$(MSBuildProjectDirectory)/construction-kits.yaml"/>
    </ItemGroup>

    <Target Name="GatherCompileFiles">
        <ItemGroup>
            <ConstructionKitFolderInputCompileFiles Include="@(ConstructionKitFolder->'%(Identity)/**/*.yaml')" />
            <!-- The bare directory entry on the left of the semicolon is intentional: keeping it forces CkCompile
                 to re-run every build (the incremental check sees a "missing file" for the directory path), which
                 in turn re-populates the obj/octo-ck-cache/.../*.json files that the SourceGenerator pulls in via
                 AdditionalFiles. Removing it correctly fixes the incremental check, but then the SourceGenerator
                 has no AdditionalFiles inputs on the rebuild-skipped path and the generated types vanish from the
                 model DLLs — broke octo-construction-kit-engine-CI build 33240. -->
            <ConstructionKitFolderOutCompileFiles Include="$(OctoCkCompileOutputCompilerFolder);$(OctoCkCompileOutputCompilerFolder)/*.yaml"/>
        </ItemGroup>
    </Target>

    <Target Name="GatherImportFiles">
        <ItemGroup>
            <ConstructionKitFolderInputImportFiles Include="@(ConstructionKitConfigFile)" />
            <ConstructionKitFolderOutImportFiles Include="$(OctoCkCompileOutputImportFolder);$(OctoCkCompileOutputImportFolder)/*.yaml"/>
        </ItemGroup>
    </Target>
    
    <!--It is generated a target which is executed before the compilation-->
    <!--
        CkCompile, CkRestore and CkIncludeFiles run as the first dependency of PrepareResources, i.e. after
        ResolveProjectReferences has built the projects this one references, and before the embedded
        resources and the AdditionalFiles of the source generator are consumed. (Hooking
        AfterTargets="ResolveProjectReferences" instead re-runs the targets in the inner project calls
        of GeneratePackageOnBuild and publishes every model twice.) A CK model project that depends on another CK model of this
        repository (System.StreamData on System) references its project; the referenced project
        publishes its model to the local file system catalog while it builds, so the dependent compile
        resolves the version built here instead of whatever the remote catalog cache last saw. Running
        before BeforeBuild (as before AB#5532) compiled the dependent model before its dependency was
        built - System.StreamData 1.14.0 pinned System 2.3.0 that way.
    -->
    <Target Name="CkCompile" Inputs="@(ConstructionKitFolderInputCompileFiles)" Outputs="@(ConstructionKitFolderOutCompileFiles)"
            DependsOnTargets="GatherCompileFiles">

        <Message Importance="High" Text="Building construction kit (target framework $(TargetFramework))" />
        <Message Importance="High" Text="Location of OctoMesh compiler package: '$(MSBuildThisFileDirectory)'"/>
        <Message Importance="High" Text="OctoLocalCatalogRootPath: '$(OctoLocalCatalogRootPath)'"/>
        <ItemGroup>
            <!-- Define a temporary item group to iterate through -->
            <_ConstructionKitFolder Include="@(ConstructionKitFolder)"/>
        </ItemGroup>

        <Message Condition="!Exists(%(_ConstructionKitFolder.Identity))" Importance="High" Text="Create new construction kit library"/>
        <Exec Condition="!Exists(%(_ConstructionKitFolder.Identity))" Command="$(OctoCompilerToolPath) -c new -p %(_ConstructionKitFolder.Identity)">
        </Exec>

        <Message Condition="Exists(%(_ConstructionKitFolder.Identity))" Importance="High" Text="Compiling construction kit library %(_ConstructionKitFolder.Identity)"/>
        <Exec Condition="Exists(%(_ConstructionKitFolder.Identity))" Command="$(OctoCompilerToolPath) -c compile -p %(_ConstructionKitFolder.Identity) -o $(OctoCkCompileOutputCompilerFolder) -c $(OctoCkCompileCacheCompileFolder) -lce $(OctoLocalCatalogIsEnabled) $(_OctoLcrArg) $(_OctoRrArg) -v none -cr" ConsoleToMSBuild="true" EchoOff="true">
            <Output TaskParameter="ConsoleOutput" ItemName="CompiledModelFiles" />
        </Exec>
        
        <ItemGroup>
            <!-- Define a temporary item group to iterate through -->
            <_CompiledModelFiles Include="@(CompiledModelFiles)"/>
        </ItemGroup>
        <!--
            Remote publish runs at most ONCE per compiled model content and catalog (AB#6119).
            CkCompile deliberately re-runs on every build (see GatherCompileFiles), and the CI 'Build src'
            step runs one `dotnet build` per src/**/*.csproj: StreamDataCkModel's invocation builds its
            ProjectReference SystemCkModel, then SystemCkModel's own invocation builds it again - so System
            was pushed to the GitHub catalog twice per run (~60 s each, CI build 50758). After a successful
            remote publish a stamp keyed by catalog, model file name and SHA-256 of the compiled yaml is
            written to obj/; a later build of the SAME content to the SAME catalog skips the remote publish
            (it would be a zero-diff commit anyway). Changed content (new version or edit) has a new hash and
            is published. The LocalFileSystemCatalog publish below is NOT guarded and runs on every build.
            Delete obj/ (or `dotnet clean`) to force a re-publish of unchanged content.
        -->
        <PropertyGroup>
            <_OctoRemotePublishActive>false</_OctoRemotePublishActive>
            <_OctoRemotePublishActive Condition="'$(OctoPublishCkModel)' == 'true' And '$(OctoPublishCkModelToRemoteCatalog)' != 'false'">true</_OctoRemotePublishActive>
            <_OctoRemotePublishStampFolder>$(IntermediateOutputPath)octo-ck-remote-publish/$(ProjectName)</_OctoRemotePublishStampFolder>
        </PropertyGroup>
        <ItemGroup Condition="'$(_OctoRemotePublishActive)' == 'true'">
            <_CkRemotePublishCandidate Include="@(_CompiledModelFiles)" Condition="Exists('%(Identity)')" />
        </ItemGroup>
        <GetFileHash Condition="'@(_CkRemotePublishCandidate)' != ''" Files="@(_CkRemotePublishCandidate)" Algorithm="SHA256" HashEncoding="hex">
            <Output TaskParameter="Items" ItemName="_CkRemotePublishHashed" />
        </GetFileHash>
        <ItemGroup>
            <_CkRemotePublishModel Include="@(_CkRemotePublishHashed)">
                <Stamp>$(_OctoRemotePublishStampFolder)/$(OctoPublishCatalog)-%(Filename)-%(FileHash).stamp</Stamp>
            </_CkRemotePublishModel>
            <_CkRemotePublishPending Include="@(_CkRemotePublishModel)" Condition="!Exists('%(Stamp)')" />
            <_CkRemotePublishSkipped Include="@(_CkRemotePublishModel)" Condition="Exists('%(Stamp)')" />
        </ItemGroup>

        <Message Condition="'%(_CkRemotePublishPending.Identity)' != ''" Importance="High" Text="Publishing construction kit library %(_CkRemotePublishPending.Identity) to catalog $(OctoPublishCatalog)"/>
        <Message Condition="'%(_CkRemotePublishSkipped.Identity)' != ''" Importance="High" Text="Skipping publish of construction kit library %(_CkRemotePublishSkipped.Identity) to catalog $(OctoPublishCatalog): identical content already published by this build output (stamp %(_CkRemotePublishSkipped.Stamp))"/>
        <Message Condition="'$(OctoPublishCkModel)' == 'true' And '$(OctoPublishCkModelToRemoteCatalog)' == 'false' And Exists(%(_CompiledModelFiles.Identity))" Importance="High" Text="Publishing construction kit library %(_CompiledModelFiles.Identity) to LocalFileSystemCatalog only (OctoPublishCkModelToRemoteCatalog=false)"/>
        <Exec Condition="'@(_CkRemotePublishPending)' != '' And $(OctoPublicGitHubApiKey) != ''" Command="$(OctoCompilerToolPath) -c config -pgt $(OctoPublicGitHubApiKey)" />
        <Exec Condition="'@(_CkRemotePublishPending)' != '' And $(OctoPrivateGitHubApiKey) != ''" Command="$(OctoCompilerToolPath) -c config -gt $(OctoPrivateGitHubApiKey) -ge true" />
        <!-- Publish to both LocalFileSystemCatalog and the specified catalog, so that the build can continue for this repo.
             OctoPublishCkModelToRemoteCatalog=false (set by test-only CK model projects such as tests/TestCkModel,
             AB#6114) keeps the LocalFileSystemCatalog publish but skips $(OctoPublishCatalog): test-only models
             (Test, System.TestIdentity) must never reach the shared GitHub catalogs. It is a project property, not
             passed on the command line, so the pipeline's /p:OctoPublishCatalog pin cannot override it. -->
        <Exec Condition="'$(OctoPublishCkModel)' == 'true' And Exists(%(_CompiledModelFiles.Identity))" Command="$(OctoCompilerToolPath) -c publish -f %(_CompiledModelFiles.Identity) -c LocalFileSystemCatalog -r $(_OctoLcrArg)" />
        <Exec Condition="'%(_CkRemotePublishPending.Identity)' != ''" Command="$(OctoCompilerToolPath) -c publish -f %(_CkRemotePublishPending.Identity) -c $(OctoPublishCatalog) -r $(_OctoLcrArg)" />
        <MakeDir Condition="'@(_CkRemotePublishPending)' != ''" Directories="$(_OctoRemotePublishStampFolder)" />
        <Touch Condition="'@(_CkRemotePublishPending)' != ''" Files="@(_CkRemotePublishPending->'%(Stamp)')" AlwaysCreate="true" />

        <Message Condition="'$(OctoGenerateCkDocumentation)' == 'true' And Exists(%(_CompiledModelFiles.Identity))" Importance="High" 
                 Text="Generating Documentation at $(OctoCkCompileOutputCompilerFolder)"/>
        <Exec Condition="'$(OctoGenerateCkDocumentation)' == 'true' And Exists(%(_CompiledModelFiles.Identity))"
              Command="$(OctoCompilerToolPath) -c generateDocs -f %(_CompiledModelFiles.Identity) -o $(OctoCkCompileOutputCompilerFolder) -l $(OctoCkLinkPath) $(_OctoLcrArg)">
        </Exec>
    </Target>

    <Target Name="CkRestore"
            DependsOnTargets="GatherImportFiles">      
        <Message Condition="Exists(%(ConstructionKitConfigFile.Identity))" Importance="High" Text="Restoring construction kit model libraries %(ConstructionKitConfigFile.Identity)"/>
        <Exec Condition="Exists(%(ConstructionKitConfigFile.Identity))" Command="$(OctoCompilerToolPath) -c restore -f %(ConstructionKitConfigFile.Identity) -o  $(OctoCkCompileOutputImportFolder) -c $(OctoCkCompileCacheImportFolder) $(_OctoLcrArg)">
        </Exec>
    </Target>
    
    <!--
        CkIncludeFiles must run as the FIRST dependency of PrepareResources, not BeforeTargets="PrepareResources":
        BeforeTargets fires only after the target's own DependsOnTargets have run, and PrepareResources depends on
        PrepareResourceNames (AssignTargetPaths, CreateManifestResourceNames), which turns @(EmbeddedResource)
        into the manifest resources handed to the compiler. An EmbeddedResource added after that is silently
        dropped. Locally it went unnoticed because the evaluation-time ItemGroups below pick up the yaml of the
        PREVIOUS build from bin/; a clean CI checkout has none, so 0.1.2610.6005 shipped the System.StreamData
        assembly without ck-system.streamdata.yaml (CI build 49921). Directory.Build.targets is imported after
        Microsoft.Common.CurrentVersion.targets, so prepending here keeps the SDK's own dependencies.
    -->
    <PropertyGroup>
        <PrepareResourcesDependsOn>CkIncludeFiles;$(PrepareResourcesDependsOn)</PrepareResourcesDependsOn>
    </PropertyGroup>

    <Target Name="CkIncludeFiles" DependsOnTargets="CkRestore;CkCompile">
        <ItemGroup>
            <_OctoCompilerResourceFilesNew Include="$(OctoCkCompileOutputCompilerFolder)/*.yaml" Exclude="@(_OctoCompilerResourceFiles)" />
            <EmbeddedResource Include="@(_OctoCompilerResourceFilesNew)">
                <LogicalName>$(RootNamespace).%(Filename)%(Extension)</LogicalName>
                <Visible>False</Visible>
                <GenerateCkModelServiceClass>$(OctoGenerateCkModelServiceClass)</GenerateCkModelServiceClass>
            </EmbeddedResource>
        </ItemGroup>

        <ItemGroup>
            <AdditionalFiles Include="$(OctoCkCompileCacheCompileFolder)/*.json" />
        </ItemGroup>

        <ItemGroup>
            <_OctoImportResourceFilesNew Include="$(OctoCkCompileOutputImportFolder)/*.yaml" Exclude="@(_OctoImportResourceFiles)" />
            <EmbeddedResource Include="@(_OctoImportResourceFilesNew)">
                <LogicalName>$(RootNamespace).%(Filename)%(Extension)</LogicalName>
                <Visible>False</Visible>
                <GenerateCkModelServiceClass>$(OctoGenerateCkModelServiceClass)</GenerateCkModelServiceClass>
            </EmbeddedResource>
        </ItemGroup>

        <ItemGroup>
            <AdditionalFiles Include="$(OctoCkCompileCacheImportFolder)/*.json" />
        </ItemGroup>
    </Target>

    <!--
        Guard (CI build 49921): every model yaml the CK compiler produced must reach the C# compiler as a
        manifest resource. An EmbeddedResource that is added too late (after PrepareResourceNames) carries no
        WithCulture/Type metadata and is silently left out of _CoreCompileResourceInputs, which ships a model
        package without its model - fail the build instead. Runs before CoreCompile even when that is skipped
        as up to date, so it checks every build.
    -->
    <Target Name="CkVerifyEmbeddedModelResources" BeforeTargets="CoreCompile"
            Condition="'@(ConstructionKitFolder)' != '' AND '$(OctoVerifyEmbeddedCkModel)' != 'false'">
        <ItemGroup>
            <_CkExpectedModelResource Include="@(_OctoCompilerResourceFiles->'$(RootNamespace).%(Filename)%(Extension)');@(_OctoCompilerResourceFilesNew->'$(RootNamespace).%(Filename)%(Extension)')" />
            <_CkActualModelResource Include="@(_CoreCompileResourceInputs->'%(LogicalName)')" />
            <_CkMissingModelResource Include="@(_CkExpectedModelResource)" Exclude="@(_CkActualModelResource)" />
        </ItemGroup>
        <Error Condition="'@(_CkExpectedModelResource)' == ''"
               Text="Construction kit project $(MSBuildProjectName) compiled no model yaml into '$(OctoCkCompileOutputCompilerFolder)'; the assembly would ship without its CK model." />
        <Error Condition="'@(_CkMissingModelResource)' != ''"
               Text="Construction kit model resource(s) @(_CkMissingModelResource, ', ') of $(MSBuildProjectName) are not passed to the compiler as embedded resources; the assembly would ship without its CK model (see CkIncludeFiles in Directory.Build.targets)." />
    </Target>

    <ItemGroup>
        <_OctoCompilerResourceFiles Include="$(OctoCkCompileOutputCompilerFolder)/*.yaml" />
        <EmbeddedResource Include="@(_OctoCompilerResourceFiles)">
            <LogicalName>$(RootNamespace).%(Filename)%(Extension)</LogicalName>
            <Visible>False</Visible>
            <GenerateCkModelServiceClass>$(OctoGenerateCkModelServiceClass)</GenerateCkModelServiceClass>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="$(OctoCkCompileCacheCompileFolder)/*.json" />
    </ItemGroup>

    <ItemGroup>
        <_OctoImportResourceFiles Include="$(OctoCkCompileOutputImportFolder)/*.yaml" />
        <EmbeddedResource Include="@(_OctoImportResourceFiles)">
            <LogicalName>$(RootNamespace).%(Filename)%(Extension)</LogicalName>
            <Visible>False</Visible>
            <GenerateCkModelServiceClass>$(OctoGenerateCkModelServiceClass)</GenerateCkModelServiceClass>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="$(OctoCkCompileCacheImportFolder)/*.json" />
    </ItemGroup>

    <!--
        CK Model Migration Files Embedding
        This target embeds migration YAML files from ConstructionKit/migrations/ folder
        as embedded resources, making them available via EmbeddedCkMigrationContentProvider.
    -->
    <PropertyGroup>
        <OctoEmbedCkMigrations Condition="'$(OctoEmbedCkMigrations)' == ''">true</OctoEmbedCkMigrations>
    </PropertyGroup>

    <Target Name="CkEmbedMigrations"
            AfterTargets="CkCompile"
            BeforeTargets="BeforeBuild"
            Condition="'@(ConstructionKitFolder)' != '' AND '$(OctoEmbedCkMigrations)' == 'true'">

        <!-- Find migration files in each ConstructionKit folder -->
        <ItemGroup>
            <_CkMigrationFilesFromFolder Include="%(ConstructionKitFolder.Identity)/migrations/*.yaml" />
        </ItemGroup>

        <Message Condition="'@(_CkMigrationFilesFromFolder)' != ''"
                 Importance="High"
                 Text="Embedding CK model migration files as resources" />

        <ItemGroup>
            <_OctoMigrationResourceFilesNew Include="@(_CkMigrationFilesFromFolder)" Exclude="@(_OctoMigrationResourceFiles)" />
            <EmbeddedResource Include="@(_OctoMigrationResourceFilesNew)">
                <LogicalName>$(RootNamespace).migrations.%(Filename)%(Extension)</LogicalName>
                <Visible>False</Visible>
            </EmbeddedResource>
            <_OctoMigrationResourceFiles Include="@(_OctoMigrationResourceFilesNew)" />
        </ItemGroup>

        <Message Condition="'@(_OctoMigrationResourceFilesNew)' != ''"
                 Importance="High"
                 Text="Embedded migration files: @(_OctoMigrationResourceFilesNew->'%(Filename)%(Extension)', ', ')" />
    </Target>

</Project>