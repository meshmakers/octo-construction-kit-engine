<Project Sdk="Microsoft.NET.Sdk">

    <!-- AB#6673: Roslyn analyzers that ship INSIDE the Meshmakers.Octo.ConstructionKit.Contracts package
         (analyzers/dotnet/cs), so every project that uses CkId / RtCkId gets them. Not a package of its own. -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <AssemblyName>Meshmakers.Octo.ConstructionKit.Analyzers</AssemblyName>
        <RootNamespace>Meshmakers.Octo.ConstructionKit.Analyzers</RootNamespace>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsPackable>false</IsPackable>
        <Configurations>Debug;Release;DebugL</Configurations>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- Compiler-bound, same pin as the source generator: a newer Microsoft.CodeAnalysis is silently skipped by older compilers. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    </ItemGroup>
</Project>
