{
  "$id": "https://schemas.meshmakers.cloud/construction-kit-compiled.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "modelId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-.]+$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9-.]+$"
      }
    },
    "dependencyRanges": {
      "description": "CK v2 range retention (AB#5664): declared range and floor of each direct dependency.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "range": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-.,\\[\\]()]+$"
          },
          "floor": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+){0,2}$"
          }
        },
        "additionalProperties": false,
        "required": ["range", "floor"]
      }
    },
    "minEngineVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "CK v2 (F1.1-S6): lowest construction kit engine version that can read this model (major.minor.patch). Written for ckLanguage 2 and range-retaining output; an engine below it refuses the import (message 126)."
    },
    "description": {
      "type": "string"
    },
    "ckLanguage": {
      "type": "integer",
      "minimum": 1,
      "description": "CK language version (CK v2, AB#5584). Omitted = 1. Version 2 enables 'interfaces', 'implements', attribute 'access', 'methods', 'visibility', 'derivable' and 'targetCkInterfaceId'. Deliberately unbounded here: an engine that reads a compiled model with a higher version than it supports rejects it with message 91 (CkLanguageNotSupported) instead of a schema error."
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "https://schemas.meshmakers.cloud/construction-kit-elements-attribute.schema.json#/definitions/CkAttribute"
      }
    },
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "https://schemas.meshmakers.cloud/construction-kit-elements-type.schema.json#/definitions/CkCompiledType"
      }
    },
    "associationRoles": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "https://schemas.meshmakers.cloud/construction-kit-elements-associationRole.schema.json#/definitions/CkAssociationRole"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "https://schemas.meshmakers.cloud/construction-kit-elements-record.schema.json#/definitions/CkRecord"
      }
    },
    "enums": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "https://schemas.meshmakers.cloud/construction-kit-elements-enum.schema.json#/definitions/CkEnum"
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "$ref": "https://schemas.meshmakers.cloud/construction-kit-elements-interface.schema.json#/definitions/CkInterface"
      }
    },
    "migrations": {
      "type": "object",
      "properties": {
        "meta": {
          "$ref": "https://schemas.meshmakers.cloud/ck-migration-meta.schema.json#/definitions/CkMigrationMeta"
        },
        "scripts": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.meshmakers.cloud/ck-migration.schema.json#/definitions/CkMigrationScript"
          }
        }
      },
      "additionalProperties": false,
      "required": ["meta"]
    }
  },
  "additionalProperties": false,
  "required": [
    "modelId"
  ]
}