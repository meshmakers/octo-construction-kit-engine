{
  "$id": "https://schemas.meshmakers.cloud/construction-kit-elements-method.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "CkMethod": {
      "type": "object",
      "title": "CkMethod",
      "description": "A method of a CK type or interface (CK v2, AB#5669). Definitions only: the signature, errors, authorization and execution settings; there is no invocation runtime yet. Requires ckLanguage: 2.",
      "properties": {
        "methodId": {
          "type": "string",
          "pattern": "^[A-Z][a-zA-Z0-9]*-\\d+$",
          "description": "Element-versioned method id, e.g. 'ChangePassword-1'."
        },
        "kind": {
          "type": "string",
          "enum": [
            "Instance",
            "Static"
          ],
          "description": "Omitted = Instance. Instance = called on one entity; Static = called on the type."
        },
        "description": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CkMethodParameter"
          }
        },
        "result": {
          "$ref": "#/definitions/CkMethodResult"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CkMethodError"
          }
        },
        "authorization": {
          "$ref": "#/definitions/CkMethodAuthorization"
        },
        "execution": {
          "$ref": "#/definitions/CkMethodExecution"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "Public",
            "Internal"
          ],
          "description": "CK v2 (F1.1-S4): Internal = may only be referenced inside the declaring model. Omitted = Public. Requires ckLanguage: 2."
        },
        "replacesGenericCreate": {
          "type": "boolean",
          "description": "AB#7024: true = this static method replaces the generic create of its type; entities of the type (and of every derived type) are created only through the method. Omitted = false. Allowed only on a static method of a non-abstract type (not on an interface method), at most one per concrete type including inherited ones; requires ckLanguage: 2. Other uses are rejected by the compiler (message 133). The asset repository refuses the generic create of such a type. The model's minEngineVersion is raised so older engines refuse it (message 126)."
        }
      },
      "additionalProperties": false,
      "required": [
        "methodId"
      ]
    },
    "CkMethodParameter": {
      "type": "object",
      "title": "CkMethodParameter",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "valueType": {
          "type": "string",
          "enum": [
            "String",
            "Boolean",
            "DateTime",
            "DateTimeOffset",
            "TimeSpan",
            "Int",
            "Int64",
            "Double",
            "StringArray",
            "IntArray",
            "Enum",
            "Record"
          ]
        },
        "valueCkRecordId": {
          "type": "string",
          "pattern": "^(?:[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*|[a-zA-Z][a-zA-Z0-9._@-]*|\\$\\{[a-zA-Z0-9_.]+\\})/[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*(?:-\\d+)?$"
        },
        "valueCkEnumId": {
          "type": "string",
          "pattern": "^(?:[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*|[a-zA-Z][a-zA-Z0-9._@-]*|\\$\\{[a-zA-Z0-9_.]+\\})/[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*(?:-\\d+)?$"
        },
        "isOptional": {
          "type": "boolean"
        },
        "sensitive": {
          "type": "boolean",
          "description": "Never logged, never in audit or traces."
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "valueType"
      ]
    },
    "CkMethodResult": {
      "type": "object",
      "title": "CkMethodResult",
      "description": "Omit 'result' for methods without a result (concept: 'result: none').",
      "properties": {
        "valueType": {
          "type": "string",
          "enum": [
            "String",
            "Boolean",
            "DateTime",
            "DateTimeOffset",
            "TimeSpan",
            "Int",
            "Int64",
            "Double",
            "StringArray",
            "IntArray",
            "Enum",
            "Record"
          ]
        },
        "valueCkRecordId": {
          "type": "string",
          "pattern": "^(?:[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*|[a-zA-Z][a-zA-Z0-9._@-]*|\\$\\{[a-zA-Z0-9_.]+\\})/[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*(?:-\\d+)?$"
        },
        "valueCkEnumId": {
          "type": "string",
          "pattern": "^(?:[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*|[a-zA-Z][a-zA-Z0-9._@-]*|\\$\\{[a-zA-Z0-9_.]+\\})/[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*(?:-\\d+)?$"
        },
        "sensitive": {
          "type": "boolean",
          "description": "AB#7006: true = the whole result value (scalar, enum or record) is sensitive and is never logged, audited or traced. Omitted = false. A method with execution.handler pipeline must not have a sensitive result (rejected by the compiler); requires ckLanguage: 2. A Secret value type is not sensitive implicitly."
        }
      },
      "additionalProperties": false,
      "required": [
        "valueType"
      ]
    },
    "CkMethodError": {
      "type": "object",
      "title": "CkMethodError",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code"
      ]
    },
    "CkMethodAuthorization": {
      "type": "object",
      "title": "CkMethodAuthorization",
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Any-of role names (role claim)."
        },
        "allowSelf": {
          "type": "boolean",
          "description": "Caller 'sub' == target rtId may invoke (instance methods only)."
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Additional required scopes. 'octo_api' is always required."
        }
      },
      "additionalProperties": false
    },
    "CkMethodExecution": {
      "type": "object",
      "title": "CkMethodExecution",
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "description": "Omitted = 15."
        },
        "idempotent": {
          "type": "boolean",
          "description": "Omitted = false."
        },
        "handler": {
          "type": "string",
          "description": "Who implements the method (AB#6877): 'service' (default; a service registers a handler) or 'pipeline' (the deployed pipeline whose well-known name equals the qualified method id handles the call). 'pipeline' requires an explicit timeoutSeconds and is not allowed on interface methods. Other values are rejected by the compiler (message 131)."
        }
      },
      "additionalProperties": false
    }
  }
}
