{
  "$id": "https://schemas.meshmakers.cloud/construction-kit-elements-type.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "CkType": {
      "type": "object",
      "title": "CkType",
      "description": "A construction kit type definition",
      "properties": {
        "typeId": {
          "type": "string",
          "pattern": "^[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*(?:-\\d+)?$",
          "description": "Type identifier in Pascal Case with optional namespace (e.g., 'Entity', 'Photovoltaic.Module', 'Entity-1')"
        },
        "derivedFromCkTypeId": {
          "type": "string",
          "pattern": "^(?:[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*|[a-zA-Z][a-zA-Z0-9._@-]*|\\$\\{[a-zA-Z0-9_.]+\\})/[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*(?:-\\d+)?$",
          "description": "Reference to base type in Pascal Case (e.g., '${this}/Entity')"
        },
        "isFinal": {
          "type": "boolean"
        },
        "isAbstract": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "displayNameRule": {
          "type": "string",
          "description": "Optional rule computing rtDisplayName from attribute values on save, e.g. '${roomNumber} - ${name ?? globalId}'. Supports ${attributePath} interpolation and the ?? coalesce operator. Inherited by derived types; nearest non-empty rule wins."
        },
        "displayDescriptionRule": {
          "type": "string",
          "description": "Optional rule computing rtDisplayDescription from attribute values on save. Same syntax and inheritance semantics as displayNameRule."
        },
        "ownerAttributePath": {
          "type": "string",
          "description": "Optional attribute path whose value identifies the owner (subject id) of a runtime entity for owned-only data permissions, e.g. 'AssigneeId' or 'Owner.UserId'. When absent, ownership is the server-stamped rtCreatedBy. Inherited by derived types; nearest declared path wins. Dot-separated segments traverse single-valued Record attributes (RecordArray is rejected); the terminal segment must be of value type String."
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "https://schemas.meshmakers.cloud/construction-kit-elements-attribute.schema.json#/definitions/CkTypeAttribute"
          }
        },
        "indexes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "indexType": {
                "type": "string",
                "enum": [
                  "None",
                  "Ascending",
                  "Text",
                  "Unique",
                  "UniqueNotDeleted"
                ]
              },
              "language": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "weight": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "attributePaths": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9_.]+$"
                      }
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "attributePaths"
                  ]
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "indexType"
            ]
          }
        },
        "associations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^(?:[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*|[a-zA-Z][a-zA-Z0-9._@-]*|\\$\\{[a-zA-Z0-9_.]+\\})/[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*(?:-\\d+)?$",
                "description": "Association role reference in Pascal Case"
              },
              "targetCkTypeId": {
                "type": "string",
                "pattern": "^(?:[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*|[a-zA-Z][a-zA-Z0-9._@-]*|\\$\\{[a-zA-Z0-9_.]+\\})/[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*(?:-\\d+)?$",
                "description": "Target type reference in Pascal Case"
              },
              "targetAttributes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?:[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*|[a-zA-Z][a-zA-Z0-9._@-]*|\\$\\{[a-zA-Z0-9_.]+\\})/[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*(?:-\\d+)?$",
                  "description": "Target attribute reference in Pascal Case"
                }
              }
            },
            "required": [
              "id",
              "targetCkTypeId"
            ]
          }
        },
        "enableChangeStreamPreAndPostImages": {
          "type": "boolean"
        },
        "implements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*|[a-zA-Z][a-zA-Z0-9._@-]*|\\$\\{[a-zA-Z0-9_.]+\\})/[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*(?:-\\d+)?$"
          },
          "description": "CK v2 (AB#5667): interfaces this type implements, e.g. '${System.Identity}/Named-1'. Inherited by derived types. Requires ckLanguage: 2."
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.meshmakers.cloud/construction-kit-elements-method.schema.json#/definitions/CkMethod"
          },
          "description": "CK v2 (AB#5669): methods of this type. Inherited by derived types. Requires ckLanguage: 2."
        },
        "visibility": {
          "type": "string",
          "enum": [
            "Public",
            "Internal"
          ],
          "description": "CK v2 (F1.1-S4): Internal = may only be referenced inside the declaring model. Omitted = Public. Requires ckLanguage: 2."
        },
        "derivable": {
          "type": "string",
          "enum": [
            "Model",
            "Any"
          ],
          "description": "CK v2 (F1.1-S4): Model = only the declaring model may derive from this element. Omitted = Model in a ckLanguage: 2 model, Any in a v1 model. Requires ckLanguage: 2."
        }
      },
      "additionalProperties": false,
      "required": [
        "typeId"
      ]
    },
    "CkCompiledType": {
      "type": "object",
      "title": "CkCompiledType",
      "description": "A construction kit compiled type definition",
      "properties": {
        "typeId": {
          "type": "string",
          "pattern": "^[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*(?:-\\d+)?$",
          "description": "Type identifier in Pascal Case with optional namespace (e.g., 'Entity', 'Photovoltaic.Module', 'Entity-1')"
        },
        "derivedFromCkTypeId": {
          "type": "string",
          "pattern": "^(?:[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*|[a-zA-Z][a-zA-Z0-9._@-]*|\\$\\{[a-zA-Z0-9_.]+\\})/[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*(?:-\\d+)?$",
          "description": "Reference to base type in Pascal Case (e.g., '${this}/Entity')"
        },
        "isFinal": {
          "type": "boolean"
        },
        "isAbstract": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "displayNameRule": {
          "type": "string",
          "description": "Optional rule computing rtDisplayName from attribute values on save, e.g. '${roomNumber} - ${name ?? globalId}'. Supports ${attributePath} interpolation and the ?? coalesce operator. Inherited by derived types; nearest non-empty rule wins."
        },
        "displayDescriptionRule": {
          "type": "string",
          "description": "Optional rule computing rtDisplayDescription from attribute values on save. Same syntax and inheritance semantics as displayNameRule."
        },
        "ownerAttributePath": {
          "type": "string",
          "description": "Optional attribute path whose value identifies the owner (subject id) of a runtime entity for owned-only data permissions, e.g. 'AssigneeId' or 'Owner.UserId'. When absent, ownership is the server-stamped rtCreatedBy. Inherited by derived types; nearest declared path wins. Dot-separated segments traverse single-valued Record attributes (RecordArray is rejected); the terminal segment must be of value type String."
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "https://schemas.meshmakers.cloud/construction-kit-elements-attribute.schema.json#/definitions/CkTypeAttribute"
          }
        },
        "indexes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "indexType": {
                "type": "string",
                "enum": [
                  "None",
                  "Ascending",
                  "Text",
                  "Unique",
                  "UniqueNotDeleted"
                ]
              },
              "language": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "weight": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "attributePaths": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9_.]+$"
                      }
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "attributePaths"
                  ]
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "indexType"
            ]
          }
        },
        "associations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^(?:[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*|[a-zA-Z][a-zA-Z0-9._@-]*|\\$\\{[a-zA-Z0-9_.]+\\})/[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*(?:-\\d+)?$",
                "description": "Association role reference in Pascal Case"
              },
              "targetCkTypeId": {
                "type": "string",
                "pattern": "^(?:[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*|[a-zA-Z][a-zA-Z0-9._@-]*|\\$\\{[a-zA-Z0-9_.]+\\})/[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*(?:-\\d+)?$",
                "description": "Target type reference in Pascal Case"
              },
              "targetAttributes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?:[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*|[a-zA-Z][a-zA-Z0-9._@-]*|\\$\\{[a-zA-Z0-9_.]+\\})/[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*(?:-\\d+)?$",
                  "description": "Target attribute reference in Pascal Case"
                }
              }
            },
            "required": [
              "id",
              "targetCkTypeId"
            ]
          }
        },
        "enableChangeStreamPreAndPostImages": {
          "type": "boolean"
        },
        "isCollectionRoot": {
          "type": "boolean"
        },
        "implements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*|[a-zA-Z][a-zA-Z0-9._@-]*|\\$\\{[a-zA-Z0-9_.]+\\})/[A-Z][a-zA-Z0-9_]*(?:\\.[A-Z][a-zA-Z0-9_]*)*(?:-\\d+)?$"
          },
          "description": "CK v2 (AB#5667): interfaces this type implements, e.g. '${System.Identity}/Named-1'. Inherited by derived types. Requires ckLanguage: 2."
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.meshmakers.cloud/construction-kit-elements-method.schema.json#/definitions/CkMethod"
          },
          "description": "CK v2 (AB#5669): methods of this type. Inherited by derived types. Requires ckLanguage: 2."
        },
        "visibility": {
          "type": "string",
          "enum": [
            "Public",
            "Internal"
          ],
          "description": "CK v2 (F1.1-S4): Internal = may only be referenced inside the declaring model. Omitted = Public. Requires ckLanguage: 2."
        },
        "derivable": {
          "type": "string",
          "enum": [
            "Model",
            "Any"
          ],
          "description": "CK v2 (F1.1-S4): Model = only the declaring model may derive from this element. Omitted = Model in a ckLanguage: 2 model, Any in a v1 model. Requires ckLanguage: 2."
        }
      },
      "additionalProperties": false
    }
  }
}
