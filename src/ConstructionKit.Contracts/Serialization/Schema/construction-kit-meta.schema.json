{
  "$id": "https://schemas.meshmakers.cloud/construction-kit-meta.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "modelId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-.]+$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9-.,\\[\\]()]+$"
      }
    },
    "description": {
      "type": "string"
    },
    "ckLanguage": {
      "type": "integer",
      "enum": [
        1,
        2
      ],
      "description": "CK language version. Omitted = 1. Version 2 enables 'interfaces' (incl. extends, association and method members, deprecated), 'implements', attribute 'access', 'methods', 'visibility', 'derivable' and association 'targetCkInterfaceId' (CK v2, AB#5584)."
    }
  },
  "additionalProperties": false,
  "required": [
    "modelId"
  ]
}