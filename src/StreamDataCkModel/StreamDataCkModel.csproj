<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>OctoMesh StreamData construction kit model defining CkArchive and related types for archive-based time-series storage.</Description>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>Meshmakers.Octo.ConstructionKit.Models.StreamData</PackageId>
        <AssemblyName>Meshmakers.Octo.ConstructionKit.Models.StreamData</AssemblyName>
        <RootNamespace>Meshmakers.Octo.ConstructionKit.Models.StreamData</RootNamespace>
        <Configurations>Debug;Release;DebugL</Configurations>
        <Platforms>AnyCPU</Platforms>
        <TargetFramework>net10.0</TargetFramework>
        <!-- See SystemCkModel.csproj for the rationale on _IsPacking. -->
        <OctoPublishCkModel Condition="'$(TargetFramework)' == 'net10.0' AND '$(_IsPacking)' != 'true'">true</OctoPublishCkModel>
        <OctoGenerateCkDocumentation Condition="'$(TargetFramework)' == 'net10.0' AND '$(_IsPacking)' != 'true'">true</OctoGenerateCkDocumentation>
        <!-- System.StreamData depends on System, which SystemCkModel (a project reference) publishes to the
             local file system catalog while it builds. The local catalog must take part in the compile, or
             the dependency resolves from the remote catalog cache, which only knows the System versions
             published so far (a new System minor would fail the System floor, AB#5532). -->
        <OctoLocalCatalogIsEnabled>true</OctoLocalCatalogIsEnabled>
        <!-- AB#6326: every attribute in ConstructionKit/attributes/*.yaml declares its ownership
             (SeedOwned / TenantOwned / RuntimeState / Secret, or the older isRuntimeState), reviewed
             against the seed ownership audit AB#6317. The CkLintRuntimeStateMarkers task is armed: a new
             attribute without a marker FAILS the build (OCTO-CK001) instead of silently defaulting to
             seed-owned, where the next blueprint update would overwrite a value the tenant entered.
             Review question for every new attribute: could an operator or user type this value in the
             product? -->
        <OctoEnforceRuntimeStateMarkers>true</OctoEnforceRuntimeStateMarkers>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\assets\meshmakers64.png">
            <Pack>True</Pack>
            <PackagePath/>
            <Link>meshmakers64.png</Link>
        </None>
        <None Include="..\..\LICENSE">
            <Pack>True</Pack>
            <PackagePath/>
            <Link>LICENSE</Link>
        </None>
    </ItemGroup>

    <!-- Import the ConstructionKit props and targets only because the package is not used as nuget package -->
    <Import Project="../ConstructionKit.SourceGeneration/build/Meshmakers.Octo.ConstructionKit.SourceGeneration.props"/>

    <ItemGroup>
        <ProjectReference Include="..\ConstructionKit.SourceGeneration\ConstructionKit.SourceGeneration.csproj" PrivateAssets="all"
                          ReferenceOutputAssembly="false"
                          ExcludeAssets="runtime"
                          OutputItemType="Analyzer">
        </ProjectReference>
        <ProjectReference Include="..\Runtime.Contracts\Runtime.Contracts.csproj"/>
        <ProjectReference Include="..\SystemCkModel\SystemCkModel.csproj"/>
    </ItemGroup>

    <!-- AB#6326: build order only. The ownership lint (OctoEnforceRuntimeStateMarkers above) runs the
         CkLintRuntimeStateMarkers task from this repository's build output (Directory.Build.targets), so the
         task assembly must be built before this project. Nothing flows into the package. -->
    <ItemGroup>
        <ProjectReference Include="..\ConstructionKit.MsBuildTasks\ConstructionKit.MsBuildTasks.csproj"
                          ReferenceOutputAssembly="false" PrivateAssets="all"
                          SetTargetFramework="TargetFramework=net10.0"
                          Condition="'$(MSBuildRuntimeType)' == 'Core'" />
        <ProjectReference Include="..\ConstructionKit.MsBuildTasks\ConstructionKit.MsBuildTasks.csproj"
                          ReferenceOutputAssembly="false" PrivateAssets="all"
                          SetTargetFramework="TargetFramework=netstandard2.0"
                          Condition="'$(MSBuildRuntimeType)' != 'Core'" />
    </ItemGroup>

    <ItemGroup>
        <ConstructionKitFolder Visible="false" Include="$(MSBuildProjectDirectory)\ConstructionKit"/>
    </ItemGroup>

</Project>
