<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <AssemblyName>Meshmakers.Octo.ConstructionKit.Compiler.Tests</AssemblyName>
        <RootNamespace>Meshmakers.Octo.ConstructionKit.Compiler.Tests</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
        <Configurations>Debug;Release;DebugL</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FakeItEasy" Version="9.0.1" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector" Version="10.0.1">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3.mtp-off" Version="4.0.0" />
        <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.9.6" />
    </ItemGroup>

    <ItemGroup>
        <None Include="sampleData\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\ConstructionKit.Compiler\ConstructionKit.Compiler.csproj" />
        <!-- AB#6294: the real CkCompile MSBuild task is executed in CkCompileTaskTests -->
        <ProjectReference Include="..\..\src\ConstructionKit.MsBuildTasks\ConstructionKit.MsBuildTasks.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- D1: the generator project is a netstandard2.0 Roslyn component; its dependency-free emitters are
             compiled in directly (same approach as ConstructionKit.Engine.Tests). -->
        <Compile Include="..\..\src\ConstructionKit.SourceGeneration\CkGenerationModelBinder.cs" Link="SourceGeneration\CkGenerationModelBinder.cs" />
        <Compile Include="..\..\src\ConstructionKit.SourceGeneration\CkTypeCodeGenerator.cs" Link="SourceGeneration\CkTypeCodeGenerator.cs" />
        <Compile Include="..\..\src\ConstructionKit.SourceGeneration\CkInterfaceCodeGenerator.cs" Link="SourceGeneration\CkInterfaceCodeGenerator.cs" />
        <Compile Include="..\..\src\ConstructionKit.SourceGeneration\ICkTypeCodeGenerator.cs" Link="SourceGeneration\ICkTypeCodeGenerator.cs" />
        <Compile Include="..\..\src\ConstructionKit.SourceGeneration\AttributeCodeGenerator.cs" Link="SourceGeneration\AttributeCodeGenerator.cs" />
    </ItemGroup>

</Project>
