    <ItemGroup>
        <!-- AB#5532: unit tests of the source generator's attribute emitters. The generator project is a
             netstandard2.0 Roslyn component whose bundled dependencies clash with this test project, so
             the (dependency-free) emitter source is compiled in directly. -->
        <Compile Include="..\..\src\ConstructionKit.SourceGeneration\AttributeCodeGenerator.cs" Link="SourceGeneration\AttributeCodeGenerator.cs" />
        <Compile Include="..\..\src\ConstructionKit.SourceGeneration\CkIdsCodeGenerator.cs" Link="SourceGeneration\CkIdsCodeGenerator.cs" />
        <!-- F1.4-S1: interface / type emitters, compiled with Roslyn against Runtime.Contracts in the tests. -->
        <Compile Include="..\..\src\ConstructionKit.SourceGeneration\CkInterfaceCodeGenerator.cs" Link="SourceGeneration\CkInterfaceCodeGenerator.cs" />
        <Compile Include="..\..\src\ConstructionKit.SourceGeneration\CkTypeCodeGenerator.cs" Link="SourceGeneration\CkTypeCodeGenerator.cs" />
        <Compile Include="..\..\src\ConstructionKit.SourceGeneration\ICkTypeCodeGenerator.cs" Link="SourceGeneration\ICkTypeCodeGenerator.cs" />
