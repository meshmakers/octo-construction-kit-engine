    <ItemGroup>
        <ProjectReference Include="..\..\src\ConstructionKit.Engine\ConstructionKit.Engine.csproj" />
        <ProjectReference Include="..\..\src\Runtime.Contracts\Runtime.Contracts.csproj" />
